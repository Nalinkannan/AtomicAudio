pkgname=atomicaudio
pkgver=0.2.0
pkgrel=1
pkgdesc='Full, wide, loud sound from laptop speakers on PipeWire'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'pipewire' 'wireplumber' 'libpulse')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/atomicaudio "$pkgdir/usr/bin/atomicaudio"
  install -Dm755 build/dsp/atomicaudio.so "$pkgdir/usr/lib/ladspa/atomicaudio.so"
  install -Dm644 "$startdir/atomicaudio.service" "$pkgdir/usr/lib/systemd/user/atomicaudio.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/atomicaudio.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/atomicaudio.svg"
  install -Dm644 "$startdir/atomicaudio.desktop" "$pkgdir/usr/share/applications/atomicaudio.desktop"
}
